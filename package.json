{
  "name": "pi-memory-extension",
  "version": "0.1.0",
  "description": "A basic TypeScript extension for Pi memory management",
  "type": "module",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "test": "node scripts/run-tests.js",
    "link": "node scripts/link-extension.js",
    "deploy": "npm run build && npm run test && npm run link"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "typebox": "^1.4.4"
  }
}
